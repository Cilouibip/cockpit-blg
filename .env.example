# Server variables only. Never prefix secrets with NEXT_PUBLIC_.
# live is the default; demo is permitted only outside Vercel and only with a local PostgreSQL URL.
COCKPIT_MODE=live
# Optional on Vercel: the production domain is detected from system variables.
APP_ORIGIN=
COCKPIT_SESSION_SECRET=
# One shared private password for the two cockpit users. Hash generated locally.
COCKPIT_PASSWORD_HASH=
IDENTITY_HMAC_SECRET=
INGEST_HMAC_SECRET=
INGEST_ALLOWED_ORIGINS=https://quizz.blg-studio.fr,https://www.blg-studio.fr
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Migration/localhost only, never needed by Vercel if Supabase REST is configured
DATABASE_URL=
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0
POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
WIX_API_KEY=
WIX_SITE_ID=
CRON_SECRET=
# Optional business-entry profiles, server-only. Real provider IDs stay in private env.
# JSON: formIds, ignoredFormIds, formNamespace, formEmailField, quiz collection/field map.
# JSON : {formIds,ignoredFormIds,formEmailField,formOriginFields:{visitor,first,current,session},quiz:{collectionId,emailField,statusField,completedStatus,originFields:{source,medium,campaign,ad,adset,linkId,pagePath,visitor},firstTouchFields:{source,medium,campaign,ad,adset,linkId,page,at,tunnel}}}
WIX_LEAD_ENTRY_CONFIG=
NOTION_CLIENT_DATA_SOURCE_ID=
# Explicit client tracking profile; comma-separated production hosts.
POSTHOG_QUIZ_HOST=
POSTHOG_PRODUCTION_HOSTS=
POSTHOG_MASTERCLASS_PAGE_ID=

# Optional declared-purchase report: clients/payments/parcours data sources and field maps.
NOTION_COMMERCE_CONFIG=
# Lecteur financier Notion (ventes payées). Absent ou toute autre valeur que `active` = suspendu :
# ni tick horaire, ni Actualiser, ni bouton Connexions, POST /api/sync/commerce refusé (423 commerce_paused).
# La dernière publication complète reste lue. Seul GET /api/jobs/commerce avec le bearer CRON_SECRET lance
# un passage de contrôle borné. `active` rétablit le comportement complet.
BLG_COMMERCE_READER=
# Cadence des flux du pilotage Masterclass (PostHog Masterclass, formulaires Wix, trois KPI quotidiens, publicités par jour).
# Absent, vide ou toute valeur autre que `30` = 60 minutes (cadence horaire antérieure, défaut de transition).
# `30` = activation explicite, seulement après les trois conditions de docs/ACTUALISATION.md §2
# (migrations 017 et 018 appliquées, observation à 60 conforme, verrou partagé actif dans les réponses du tick).
# Les autres flux restent à une heure. Procédure de bascule du déclencheur : docs/ACTUALISATION.md.
BLG_REFRESH_CADENCE_MINUTES=

# Lectures Meta des uniques pour le CTR unique du tableau (lot U8b) : par défaut, chaque passage kpi_meta ajoute une lecture
# niveau compte par jour (campagnes Masterclass dédoublonnées) et six lectures de fenêtre (3, 7, 30 jours finissant hier et
# aujourd'hui). Leur échec n'empêche pas la publication de la dépense (CTRU « non mesuré » avec le code). `off` = retour exact aux
# deux lectures d'avant U8b (CTRU non mesuré). Toute autre valeur ou absence = lectures actives.
BLG_KPI_META_UNIQUE_READS=

# Migration 023 (facultatif) : fenêtre horaire « de-à » (heures 0-23, Europe/Paris) de la relecture Notion complète quotidienne,
# par exemple 2-4 : la pointe d'âge des rendez-vous pendant cette relecture (50 à 80 min selon le profil) tombe la nuit ; jamais plus
# de 36 h sans relecture complète. Absent : relecture complète dès 24 h (règle 021). Valeur invalide : unité Notion en échec explicite.
BLG_NOTION_FULL_HOURS=

# Optional Masterclass destination; default /masterclass26 (published 16 September 2026; /blank-1 redirects there). Also sets
# the measured page path used to count masterclass visitors (PostHog page_path). Existing link revisions are preserved.
BLG_MASTERCLASS_URL=

# Legacy offline validation fixtures only; production reads persisted automatic source publications.
# No KPI JSON or local file is required by the deployed API.
BLG_KPI_FUNNEL_JSON=
BLG_KPI_FUNNEL_PATH=

# Optional explicit override of the masterclass campaign scope; reviewed defaults are in kpi-funnel-live.ts.
BLG_KPI_MASTERCLASS_CAMPAIGN_IDS=
# Exact custom conversion action. Default: reviewed RDV Calendly BLG HOMME; never generic Schedule.
BLG_KPI_META_BOOKING_ACTION=
