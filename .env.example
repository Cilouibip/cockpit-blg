# Server variables only. Never prefix secrets with NEXT_PUBLIC_.
# live is the default; demo is permitted only outside Vercel and only with a local PostgreSQL URL.
COCKPIT_MODE=live
APP_ORIGIN=https://cockpit.example.com
COCKPIT_SESSION_SECRET=
# One shared private password for the two cockpit users. Hash generated locally.
COCKPIT_PASSWORD_HASH=
IDENTITY_HMAC_SECRET=
INGEST_HMAC_SECRET=
INGEST_ALLOWED_ORIGINS=https://quizz.blg-studio.fr,https://www.blg-studio.fr
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Migration/localhost only, never needed by Vercel if Supabase REST is configured
DATABASE_URL=
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_API_VERSION=v23.0
POSTHOG_HOST=
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
WIX_API_KEY=
WIX_SITE_ID=
CRON_SECRET=
